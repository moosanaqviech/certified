{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://certify.courses/catalog.schema.json",
  "title": "certify.courses app catalog",
  "description": "Shape of catalog.json, the course list the mobile app renders. The display fields from questions_total to price_note are filled by scripts/build_catalog.py from the root catalog page; every one of them is optional and absent when the page shows no value.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generated_at", "certs"],
  "properties": {
    "version": { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "certs": {
      "type": "array",
      "items": { "$ref": "#/$defs/cert" }
    }
  },
  "$defs": {
    "cert": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "vendor", "track", "exam_code", "monogram", "accent", "ink", "lesson_url", "lessons_total", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "vendor": { "type": "string", "minLength": 1 },
        "track": { "type": "string", "minLength": 1 },
        "exam_code": { "type": ["string", "null"] },
        "monogram": { "type": "string", "minLength": 1 },
        "accent": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "ink": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "lesson_url": { "type": "string", "format": "uri" },
        "lessons_total": { "type": "integer", "minimum": 0 },
        "status": { "type": "string", "enum": ["live", "planned"] },
        "exam_available_from": { "type": "string", "format": "date" },
        "units": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 }
            }
          }
        },
        "questions_total": { "type": "integer", "minimum": 0 },
        "mocks_total": { "type": "integer", "minimum": 0 },
        "level": { "type": "string", "enum": ["foundational", "associate", "professional", "specialty"] },
        "last_verified": { "type": "string", "format": "date" },
        "icon": { "type": "string", "enum": ["database", "ml", "genai", "analytics", "spark"] },
        "practice_url": { "type": "string", "format": "uri" },
        "ready_url": { "type": "string", "format": "uri" },
        "guide_url": { "type": "string", "format": "uri" },
        "price": { "type": "string" },
        "price_note": { "type": "string" }
      }
    }
  }
}
